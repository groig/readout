# Copy to .env next to compose.example.yml and fill in.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
PHX_HOST=share.example.com

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=infra@example.com
SMTP_PASSWORD=
MAIL_FROM=infra@example.com
MAIL_FROM_NAME=Readout

PROXY_NETWORK=proxy
# Caddy's address on the proxy network (docker network inspect proxy).
TRUSTED_PROXIES=
# Asked for at first-run setup (openssl rand -hex 16). Remove after setup.
SETUP_TOKEN=
# Optional: networks allowed to reach setup and admin settings.
ADMIN_NETWORKS=
